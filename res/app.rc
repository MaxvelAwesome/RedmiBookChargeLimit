            VALUE "InternalName", "RedmiChargeLimit"
            VALUE "OriginalFilename", "RedmiChargeLimit.exe"
            VALUE "ProductName", "RedmiBook Charge Limit"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
